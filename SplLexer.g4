lexer grammar SplLexer;
INT      : 'int';
STRUCT   : 'struct';
RETURN   : 'return';
IF       : 'if';
ELSE     : 'else';
WHILE    : 'while';
LE       : '<=';
GE       : '>=';
EQ       : '==';
NEQ      : '!=';
AND      : '&&';
OR       : '||';
ASSIGN   : '=';
PLUS     : '+';
MINUS    : '-';
MUL      : '*';
DIV      : '/';
MOD      : '%';
POW      : '^';
LT       : '<';
GT       : '>';
NOT      : '!';
DOT      : '.';
LPAREN   : '(';
RPAREN   : ')';
LBRACK   : '[';
RBRACK   : ']';
LBRACE   : '{';
RBRACE   : '}';
SEMI     : ';';
COMMA    : ',';
Number   : '0' | [1-9][0-9]*;
Identifier : [a-zA-Z_] [a-zA-Z0-9_]*;
LINE_COMMENT : '//' ~[\r\n]* -> skip;
BLOCK_COMMENT: '/*' .*? '*/' -> skip;
WS : [ \t\r\n]+ -> skip;
